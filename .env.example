# Copy this file to .env and fill in real values, then:
#   docker compose up -d --build
#
# .env is gitignored — never commit real secrets.

# Any strong random password — used only inside this server's private
# Docker network, Postgres is never exposed to the internet.
POSTGRES_PASSWORD=change-me-to-something-long-and-random

# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-too

# Optional — only needed once you wire up real Stripe invoicing (see
# DEPLOYMENT.md). Leave blank until then.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
