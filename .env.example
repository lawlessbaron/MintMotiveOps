# Copy this file to .env and fill in real values, then:
#   docker compose up -d --build
#
# .env is gitignored — never commit real secrets.

# Any strong random password — used only inside this server's private
# Docker network, Postgres is never exposed to the internet.
POSTGRES_PASSWORD=change-me-to-something-long-and-random

# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-too

# Optional — only needed once you wire up real Stripe invoicing (see
# DEPLOYMENT.md). Leave blank until then.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional — needed for self-service "Forgot Password" reset codes to
# actually be emailed (see app/email_client.py). Without these set, the
# reset flow still works end-to-end but the code only reaches the server
# log, not the user's inbox — fine for local testing, not for real use.
# Any standard SMTP provider works (Gmail app password, SendGrid, Postmark,
# your own mail server, etc.) — port 587 (STARTTLS) or 465 (SSL).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
